--- a/hw/ip/aon_timer/dv/env/seq_lib/aon_timer_base_vseq.sv
+++ b/hw/ip/aon_timer/dv/env/seq_lib/aon_timer_base_vseq.sv
@@ -54,6 +54,8 @@
   longint unsigned steer_value;
   int unsigned steer_aux_field;
   longint unsigned steer_aux_value;
+  bit aon_timer_config_interrupted;
+  int unsigned aon_timer_config_generation;
 
   constraint thold_count_c {
     solve wkup_count_gap, wkup_thold before wkup_count;
@@ -234,6 +236,8 @@
   // setup basic aon_timer features
   task aon_timer_init();
     bit [31:0] wkup_ctrl_readback;
+    aon_timer_config_interrupted = 1'b0;
+    aon_timer_config_generation = cfg.aon_timer_reset_generation;
 
     // A TL write can finish before its AON-domain register has updated. Fence
     // disable before changing the split counter/threshold registers.
@@ -262,6 +266,11 @@
     `uvm_info(`gfn, $sformatf("Writing 0x%0h to wdog_bite_thold", wdog_bite_thold), UVM_HIGH)
     csr_utils_pkg::csr_wr(ral.wdog_bite_thold, wdog_bite_thold);
 
+    // The threshold registers cross into the AON clock domain. After an
+    // injected reset, the frontdoor write can complete before the AON-side
+    // state has settled; wait before the strict readback fence below.
+    cfg.aon_clk_rst_vif.wait_clks(5);
+
     cfg.lc_escalate_en_vif.drive(0);
 
     // Set pause mode before WDOG_REGWEN can lock WDOG_CTRL.
@@ -272,22 +281,37 @@
     `uvm_info(`gfn, $sformatf("Writing 0x%0h to WDOG_REGWEN", wdog_regwen), UVM_HIGH)
     csr_utils_pkg::csr_wr(ral.wdog_regwen, wdog_regwen);
 
-    aon_timer_sync_wkup_configuration(64'b0);
+    aon_timer_sync_wkup_configuration(64'b0, aon_timer_config_generation);
+    if (aon_timer_config_interrupted) return;
   endtask
 
   // Frontdoor reads wait for each CSR's CDC transaction to complete. Compare
   // with the requested stimulus before enable: never use DUT values as an oracle.
-  task aon_timer_sync_wkup_configuration(bit [63:0] expected_count);
+  task aon_timer_sync_wkup_configuration(bit [63:0] expected_count,
+                                               int unsigned reset_generation);
     bit [63:0] count_readback, thold_readback;
+    if (cfg.aon_timer_reset_generation != reset_generation) begin
+      aon_timer_config_interrupted = 1'b1;
+      `uvm_info(`gfn, $sformatf("WKUP readback skipped: reset interrupted configuration (%0d -> %0d); reset CSR audit checks the reset values",
+                                reset_generation, cfg.aon_timer_reset_generation), UVM_LOW)
+      return;
+    end
     csr_rd(.ptr(ral.wkup_count_lo), .value(count_readback[31:0]));
     csr_rd(.ptr(ral.wkup_count_hi), .value(count_readback[63:32]));
     csr_rd(.ptr(ral.wkup_thold_lo), .value(thold_readback[31:0]));
     csr_rd(.ptr(ral.wkup_thold_hi), .value(thold_readback[63:32]));
+    if (cfg.aon_timer_reset_generation != reset_generation) begin
+      aon_timer_config_interrupted = 1'b1;
+      `uvm_info(`gfn, $sformatf("WKUP readback skipped: reset interrupted configuration (%0d -> %0d); reset CSR audit checks the reset values",
+                                reset_generation, cfg.aon_timer_reset_generation), UVM_LOW)
+      return;
+    end
     `DV_CHECK_CASE_EQ(count_readback, expected_count)
     `DV_CHECK_CASE_EQ(thold_readback, wkup_thold)
   endtask
 
   virtual task apply_reset(string kind = "HARD");
+    if (kind == "HARD") cfg.aon_timer_reset_generation++;
     cfg.lc_escalate_en_vif.drive(initial_lc_escalate_en);
     cfg.sleep_vif.drive(initial_sleep_mode);
 
@@ -309,6 +333,7 @@
   endtask // apply_reset
 
   virtual task apply_resets_concurrently(int reset_duration_ps = 0);
+    cfg.aon_timer_reset_generation++;
     cfg.aon_clk_rst_vif.drive_rst_pin(0);
     super.apply_resets_concurrently(cfg.aon_clk_rst_vif.clk_period_ps);
     cfg.aon_clk_rst_vif.drive_rst_pin(1);
