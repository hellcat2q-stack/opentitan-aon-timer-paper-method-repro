--- a/hw/ip/aon_timer/dv/env/aon_timer_scoreboard.sv
+++ b/hw/ip/aon_timer/dv/env/aon_timer_scoreboard.sv
@@ -303,6 +303,16 @@
           // Wait a further 5 clocks for the interrupt to propagate through logic in the clk domain
           // to become visible on the top-level pins.
           cfg.clk_rst_vif.wait_clks(5);
+          // Enable/configuration CDC and the AON interrupt flop can leave the
+          // countdown prediction ahead of the output by AON cycles. A main-clk
+          // poll cannot cover that delay (one AON period is about 480 clk cycles).
+          // Bound the settling window in the slow domain, then allow the fast
+          // synchronizer to settle. A stuck-low interrupt must still fail below.
+          for (int unsigned aon_wait_cycles = 0; aon_wait_cycles < 4; aon_wait_cycles++) begin
+            if (cfg.intr_vif.sample_pin(.idx(WKUP)) === intr_status_exp[WKUP]) break;
+            cfg.aon_clk_rst_vif.wait_clks(1);
+            cfg.clk_rst_vif.wait_clks(5);
+          end
           // Check interrupt pin
           `DV_CHECK_CASE_EQ(intr_status_exp[WKUP],
                             cfg.intr_vif.sample_pin(.idx(WKUP)))
